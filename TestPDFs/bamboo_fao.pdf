;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;68dc5cd1-7556-400a-8bc5-7185be9e31df&q;,&q;language&q;:null,&q;value&q;:&q;2026-03-06T16:55:56Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;2ec6a2d7-b00b-4afe-bed1-f4770a6ffff1&q;,&q;language&q;:null,&q;value&q;:&q;2026-03-06T16:55:56Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;655d5456-acca-4b51-ad4b-0984cce6f6e1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2024&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;231366f1-b0cd-43c3-97c6-2363e2694a6a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-03-06T16:53:14Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;a9eb230e-7fce-4e71-957f-4be36a87ef41&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;En la edición de 2024 de El estado mundial de la pesca y la acuicultura, se muestra la transformación azul en acción, ilustrada mediante actividades e iniciativas dirigidas por la FAO en colaboración con Miembros, asociados y partes interesadas clave, con vistas a integrar los alimentos acuáticos en la seguridad alimentaria y la sostenibilidad mundiales, potenciar la promoción de las políticas, la investigación científica y la creación de capacidad, difundir prácticas sostenibles e innovaciones tecnológicas, así como apoyar la participación de la comunidad.La Parte 1 de esta edición de El estado mundial de la pesca y la acuicultura se beneficia de mejoras significativas en la recopilación de datos, así como los instrumentos y metodologías analíticos y de evaluación para presentar el examen más actualizado de la producción y utilización de la pesca y la acuicultura a nivel mundial. En la Parte 2 se destaca la función de la FAO y sus asociados a la hora de impulsar los cambios para la transformación necesarios para apoyar la expansión e intensificación de la acuicultura, la ordenación eficaz de la pesca mundial y la actualización de las cadenas de valor acuáticas. La Parte 3 abarca los desafíos de alto impacto y las oportunidades para aprovechar el potencial inexplorado de utilizar pescado entero y subproductos para mejorar la seguridad alimentaria y la nutrición, describe la función de los sistemas alimentarios acuáticos a la hora de aportar soluciones vitales relacionadas con el clima y la biodiversidad y ecológicamente adecuadas, y destaca la importancia de su integración en los procesos nacionales y multilaterales. Asimismo, presenta una perspectiva sobre las tendencias futuras hasta 2032 basándose en previsiones.El estado mundial de la pesca y la acuicultura 2024 proporciona la información más actualizada y basada en datos objetivos, que respalda las normas políticas, científicas y técnicas sobre desafíos, oportunidades e innovaciones que determinan el presente y el futuro del sector, para beneficio de un público amplio y cada vez mayor de encargados de formular políticas, personal directivo, científicos, pescadores, acuicultores, comerciantes, activistas de la sociedad civil y consumidores.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;8eb8b2bc-e221-4723-86ff-e74e447550b2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;278 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eisbn&q;:[{&q;uuid&q;:&q;4ab8fc5d-c012-49e4-86cc-21a6f61c0d64&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-138818-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;80cae75f-4335-42e4-b1fe-f5e2dac804ac&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-138819-8&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;b41897b8-5a31-4ce6-b140-d13957a8d556&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8649&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.