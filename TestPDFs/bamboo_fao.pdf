/openknowledge.fao.org/server/api/core/items/4b1f7d26-267d-4a81-aed4-4f9de4d93f85&q;:{&q;data&q;:{&q;handle&q;:&q;20.500.14283/cd6008en&q;,&q;lastModified&q;:&q;2026-03-26T17:14:29.930Z&q;,&q;isArchived&q;:true,&q;isDiscoverable&q;:true,&q;isWithdrawn&q;:false,&q;_links&q;:{&q;bundles&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4b1f7d26-267d-4a81-aed4-4f9de4d93f85/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4b1f7d26-267d-4a81-aed4-4f9de4d93f85/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4b1f7d26-267d-4a81-aed4-4f9de4d93f85/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4b1f7d26-267d-4a81-aed4-4f9de4d93f85/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4b1f7d26-267d-4a81-aed4-4f9de4d93f85/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4b1f7d26-267d-4a81-aed4-4f9de4d93f85/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4b1f7d26-267d-4a81-aed4-4f9de4d93f85/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4b1f7d26-267d-4a81-aed4-4f9de4d93f85/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/4b1f7d26-267d-4a81-aed4-4f9de4d93f85&q;}},&q;_name&q;:&q;The State of Food Security and Nutrition in the World 2025&q;,&q;id&q;:&q;4b1f7d26-267d-4a81-aed4-4f9de4d93f85&q;,&q;uuid&q;:&q;4b1f7d26-267d-4a81-aed4-4f9de4d93f85&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;957e6089-741e-4fde-81ca-c6fe384c7763&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; IFAD; UNICEF; WFP; WHO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;2a060114-dcf4-46d7-afb2-3d1e04d91670&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-19T10:31:34Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;95e667c3-054e-41f0-a478-3571e6789a93&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-19T10:31:34Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;11774197-a63c-4edd-9bbc-13f01311cf07&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;03d48fe0-4faa-48a3-8b73-d6f2f67f2d0a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-02-19T10:29:24Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;6697f355-6086-4a5b-8fa7-1606ecb6a76d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;While some progress and recovery have been made in recent years, the world is still above pre-COVID-19 pandemic levels and far from eradicating hunger and food insecurity by 2030 (SDG Target 2.1). Similarly, despite some progress in the global nutrition targets, the world is not on track to achieve SDG Target 2.2. Among other factors, persistent food price inflation has slowed this momentum.The State of Food Security and Nutrition in the World 2025 highlights how elevated inflation in many countries has undermined purchasing power and, especially among low-income populations, access to healthy diets. The report documents how high food price inflation is associated with increases in food insecurity and child malnutrition. Vulnerable groups, including low-income households, women, and rural communities, can be particularly affected by food price inflation, risking setbacks in the fight against hunger and malnutrition.In response to these challenges and to prevent future price shocks, the report examines policy measures adopted by countries, and outlines what is necessary going forwards. It stresses the importance of coherent implementation of fiscal and monetary policies to stabilize markets, promote open and resilient trade, and protect vulnerable populations. Additionally, it calls for better data systems and sustained investment in resilient agrifood systems to build long-term food security and nutrition. These coordinated actions are vital to reignite progress towards ending hunger and malnutrition by 2030.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;b15ec872-dd51-4525-9af8-0778824910e6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;234 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eisbn&q;:[{&q;uuid&q;:&q;b1916452-dbdd-4f93-805f-b79bd0e5b448&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-139938-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;76f094a9-0750-4e8e-914c-5364562d699b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-807X&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;8d5ad6fc-652e-4ddd-9730-987cade37445&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-139937-8&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;eba4afdc-79b7-4d3f-94b3-475517af6c95&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8061&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;e0bfb208-07af-43e7-a151-4b7aa85fa7f2&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd6008en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;2e7e1b06-44bc-4dd2-9c62-1325f45a6fc4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;f152a759-8402-47a7-a9a3-dbab4e578073&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; IFAD ; UNICEF ; WFP ; WHO ;&q;,&q;place&q;:0,&q;a