</div>
</ds-selective-truncatable><!---->
</div>
</ds-item-search-result-list-element><!---->
</ds-listable-object-component-loader>
      </li><li _ngcontent-sc616="" class="pt-2 pb-2 d-flex ng-tns-c616-11 ng-star-inserted">
        <ds-listable-object-component-loader _ngcontent-sc616="" class="ng-tns-c616-11" _nghost-sc116=""><ds-item-search-result-list-element _nghost-sc866="" class="ng-star-inserted">
