wledge.fao.org/server/api/core/items/8ab20ccf-1e9d-4ae6-836c-ca770d16da01/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/8ab20ccf-1e9d-4ae6-836c-ca770d16da01/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/8ab20ccf-1e9d-4ae6-836c-ca770d16da01/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/8ab20ccf-1e9d-4ae6-836c-ca770d16da01&q;}},&q;_name&q;:&q;The State of World Fisheries and Aquaculture 2024&q;,&q;id&q;:&q;8ab20ccf-1e9d-4ae6-836c-ca770d16da01&q;,&q;uuid&q;:&q;8ab20ccf-1e9d-4ae6-836c-ca770d16da01&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;318304a8-eb93-4c9a-9b20-80f47bc0bb60&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;cdefdf04-f21d-4eb0-98d1-a4ae742c57a8&q;,&q;language&q;:null,&q;value&q;:&q;2025-10-01T16:18:19Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;3d8d2fa4-eb43-4078-af03-8c3fe7a8efb5&q;,&q;language&q;:null,&q;value&q;:&q;2025-10-01T16:18:19Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;4fb6ff75-bfdb-4253-92a6-295db4e6f4a9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2024&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;aeebcc5b-4acd-494c-8759-3115ca6b59b0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-10-01T16:11:33Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;a32d333f-daf5-4202-9798-eccde907a67e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The 2024 edition of The State of World Fisheries and Aquaculture features the Blue Transformation in action, illustrated by activities and initiatives, led by FAO in collaboration with Members, partners and key stakeholders, to integrate aquatic foods into global food security and sustainability, enhance policy advocacy, scientific research and capacity building, disseminate sustainable practices and technological innovations, and support community involvement. Part 1 of this edition of The State of World Fisheries and Aquaculture benefits from significant improvements in data collection, analytical and assessment tools and methodologies to present the most up-to-date review of world fisheries and aquaculture production and utilization. Part 2 highlights the role of FAO and its partners to catalyse the transformational changes required to support aquaculture expansion and intensification, effective management of global fisheries and upgrading of aquatic value chains. Part 3 covers the high-impact challenges and opportunities of the untapped potential of utilizing whole fish and by-products to improve food security and nutrition, expounds on the role of aquatic food systems in providing critical climate, biodiversity and environmentally sound solutions, and highlights the importance of their integration into national and multilateral processes. It also presents an outlook on future trends up to 2032 based on projections.  The State of World Fisheries and Aquaculture 2024 provides the most up-to-date and evidence-based information, supporting policy, scientific and technical insights on challenges, opportunities and innovations shaping the present and future of the sector, for the benefit of a wide and expanding audience of policymakers, managers, scientists, fishers, farmers, traders, civil society activists and consumers.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;cc030097-8ebe-427f-a035-5ade4643a851&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;264 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eisbn&q;:[{&q;uuid&q;:&q;765f1e76-6a63-4946-b431-1db0381626cd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-138764-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;e3dedc1f-b95d-4d20-9708-742597ece887&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-138765-8&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;7510acde-d08f-4813-b133-d569a91898a8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2410-5902&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;278ed222-75ee-42bc-abae-9d77791738b5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-138763-4&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;f7d31f39-aa27-4491-a2d2-110527dd243d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1020-5489&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;9eb1d0ec-7fd4-463a-839c-150f12bd1661&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd0683en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;ad20dd71-c908-40dc-80a9-50945adef93d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;a615d662-3807-4b43-84c9-67ebd5f873d2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;a6e2b0e1-ea41-4b4d-9d6b-3889c4fc15d9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The State of World Fisheries and Aquaculture (SOFIA)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;90c8900c-f370-4a90-874e-caf8fce86084&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2024&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;4c00ffcf-958e-44ac-b80d-3c70a5608f03&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0