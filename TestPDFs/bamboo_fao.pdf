08-14T13:58:01.0000000Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;09c2497d-802e-499f-8048-5559abd6adb2&q;,&q;language&q;:null,&q;value&q;:&q;The significance of industrial processing for the nature of food and the state of human health - and in particular the techniques and ingredients developed by modern food science and technology - is generally underestimated. This is evident in both national and international policies and strategies designed to improve populations&s; nutrition and health. Until recently it has also been neglected in epidemiological and experimental studies concerning diet, nutrition and health.\n\nThis report seeks to assess the impact of ultra-processed food on diet quality and health, based on NOVA, a food classification system developed by researchers at the University of Sao Paulo, Brazil.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;2b9b1b38-1913-4e65-8706-a356a4ef019b&q;,&q;language&q;:null,&q;value&q;:&q;48 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;9cfad0ba-6467-417f-9e81-dc65c910ca18&q;,&q;language&q;:null,&q;value&q;:&q;978-92-5-131701-3&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;8b0e2614-a709-4434-ade2-81211c5fb925&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ca5644en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.url&q;:[{&q;uuid&q;:&q;4377083a-21e2-44d5-b43c-8946e98d7310&q;,&q;language&q;:null,&q;value&q;:&q;http://www.fao.org/3/ca5644en/ca5644en.pdf&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;361cfb07-9701-48d3-82ea-fee36d90e1fa&q;,&q;language&q;:null,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;6