ef&q;:&q;https://openknowledge.fao.org/server/api/core/items/d6e43b1c-85a4-4eb7-8b0d-c9d1fdfa6547/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d6e43b1c-85a4-4eb7-8b0d-c9d1fdfa6547/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d6e43b1c-85a4-4eb7-8b0d-c9d1fdfa6547/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d6e43b1c-85a4-4eb7-8b0d-c9d1fdfa6547&q;}},&q;_name&q;:&q;Cостояние мирового рыболовства и аквакультуры 2024&q;,&q;id&q;:&q;d6e43b1c-85a4-4eb7-8b0d-c9d1fdfa6547&q;,&q;uuid&q;:&q;d6e43b1c-85a4-4eb7-8b0d-c9d1fdfa6547&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;0c400451-845f-4120-b3d7-a21296fad90a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;f25faff7-a33f-4ecd-8935-d98a14522dd9&q;,&q;language&q;:null,&q;value&q;:&q;2026-03-06T15:16:04Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;8a7b1fa7-7b43-4b95-af69-17bb5cac082c&q;,&q;language&q;:null,&q;value&q;:&q;2026-03-06T15:16:04Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;654f0450-5601-4138-8982-93e19cf42b13&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2024&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;93c1c018-29c5-4bea-9587-7b962008f7c1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-03-06T15:11:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;1ee87469-71c2-4f2c-b1d5-01ef41b9d7f0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;В докладе “Состояние мирового рыболовства и аквакультуры – 2024”, основная тема которого – «“Голубая трансформация” в действии», приводятся примеры координируемых ФАО в сотрудничестве с членами, партнерами и ключевыми заинтересованными сторонами мероприятий и инициатив, направленных на более полный учет вопросов пищевых продуктов из водных биоресурсов в работе по обеспечению глобальной продовольственной безопасности и устойчивости, на расширение информационно-просветительской деятельности в области политики, научных исследований и мероприятий по наращиванию потенциала, распространение устойчивых подходов и технических новшеств, а также на содействие привлечению к работе населения.При подготовке части 1 настоящего издания доклада “Состояние мирового рыболовства и аквакультуры” использовались существенно усовершенствованные подходы к сбору данных, модернизированные инструменты и методики анализа и оценки, что позволило представить максимально актуальный обзор производства и использования продукции мирового рыболовства и аквакультуры. Часть 2 посвящена роли ФАО и ее партнеров в стимулировании преобразований, необходимых для расширения и интенсификации аквакультуры, эффективной эксплуатации мировых рыбных ресурсов и повышения эффективности производственно-сбытовых цепочек продукции из водных биоресурсов. В части 3 рассматриваются проблемы и возможности, связанные с нереализованным потенциалом использования цельной рыбы и побочных продуктов для улучшения положения в области продовольственной безопасности и питания, описывается роль систем производства пищевой продукции из водных биоресурсов в поиске критически важныхрешений в области климата, биоразнообразия и окружающей среды, а также указывается на важность их интеграции в национальные и многосторонние процессы. Кроме того, в ней дается прогноз тенденций на период до 2032 года на основе перспективных оценок.Доклад “Состояние мирового рыболовства и аквакультуры – 2024” ориентирован на широкую и растущую аудиторию, в которую входят представители директивных органов и специалисты по управлению, ученые, рыбаки, фермеры, торговцы, активные представители гражданского общества и потребители, и в нем приведена максимально актуальная информация с опорой на фактические данные и представлены стратегические, научные и технические выводы о проблемах, возможностях и инновационных решениях, влияющих на настоящее и будущее сектора.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;0d24d883-670d-460b-84ae-7ee8cc2e635a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;264 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eisbn&q;:[{&q;uuid&q;:&q;2cb26362-7e28-46a7-9720-500f8a5aed10&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-138812-9&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;ab6060fc-3fa5-47f0-8535-f7f7a7332e1a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-138813-6&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;e40f5d8e-251c-4f5b-a535-d0c3f470ed88&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8657&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;3cd59f2f-30fe-4362-8c7e-c07aab80e56d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-138811-2&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;830f146a-2185-4a66-9e86-5d4cd74198ad&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2070-6197&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;84ba347f-7048-4104-ab08-d8e6e39932f2&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd0683ru&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;8ffb1e2c-136c-4c9f-a93c-4bef03393a6b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Russian&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;0ea88259-e475-4f7c-8d7c-e9823c40367e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;ФАО ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;co