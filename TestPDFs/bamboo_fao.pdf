r/api/core/items/5f0cec17-98b7-4d74-9cb1-6ea829b7d920&q;:{&q;data&q;:{&q;handle&q;:&q;20.500.14283/cd5886en&q;,&q;lastModified&q;:&q;2026-02-10T23:19:13.650Z&q;,&q;isArchived&q;:true,&q;isDiscoverable&q;:true,&q;isWithdrawn&q;:false,&q;_links&q;:{&q;bundles&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/5f0cec17-98b7-4d74-9cb1-6ea829b7d920/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/5f0cec17-98b7-4d74-9cb1-6ea829b7d920/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/5f0cec17-98b7-4d74-9cb1-6ea829b7d920/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/5f0cec17-98b7-4d74-9cb1-6ea829b7d920/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/5f0cec17-98b7-4d74-9cb1-6ea829b7d920/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/5f0cec17-98b7-4d74-9cb1-6ea829b7d920/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/5f0cec17-98b7-4d74-9cb1-6ea829b7d920/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/5f0cec17-98b7-4d74-9cb1-6ea829b7d920/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/5f0cec17-98b7-4d74-9cb1-6ea829b7d920&q;}},&q;_name&q;:&q;The Status of Youth in Agrifood Systems&q;,&q;id&q;:&q;5f0cec17-98b7-4d74-9cb1-6ea829b7d920&q;,&q;uuid&q;:&q;5f0cec17-98b7-4d74-9cb1-6ea829b7d920&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;fd559dce-187c-46e3-aa23-155e80b61ad0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;0346cf4e-bed3-4d6e-9316-0128f828234f&q;,&q;language&q;:null,&q;value&q;:&q;2025-11-25T15:22:33Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;c93e4274-2111-4e8d-a68c-35bfe74b6361&q;,&q;language&q;:null,&q;value&q;:&q;2025-11-25T15:22:33Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;dae648ac-de11-4453-9efe-76a5f9cb6989&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;c5cdcc47-8b53-4392-b16e-77d70ec21d88&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-11-25T15:20:54Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;93b10ef6-022e-404d-98ab-85017a848834&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The world&s;s agrifood systems stand at a crossroads. With 1.3 billion youth globally, the future of food, livelihoods, and economic resilience depends on their participation in agrifood systems. At the same time, agrifood systems need youth to drive productivity, innovation, and sustainability in a crucial and rapidly evolving sector.FAO&s;s \&q;The Status of Youth in Agrifood Systems\&q; report is a call to action. It presents the most comprehensive, evidence-based analysis of youth in agrifood systems to date, highlighting both the opportunities and structural barriers that shape their engagement. It explores how transforming agrifood systems can enhance decent job opportunities and food security for youth, and how empowered youth can drive this transformation.It concludes highlighting policy recommendations and areas of investments to foster more equitable and sustainable agrifood systems, where rural youth are both beneficiaries and leaders of change.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;289e33fd-7d04-488a-83eb-d540e54fed43&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;350 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;8b258c60-62f1-4ed0-bdda-4c4d84a68824&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-139920-0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;d4d19c18-8a50-42c2-b3ed-b5512cf73e92&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd5886en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;4f259bb4-71a9-4f1d-8c39-28d8358ce804&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;6699a9a2-3c87-4917-aa3f-1861ca0df8d5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;a648c2a7-2f38-4baf-a0dd-0e221002c9e3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;c4a3a318-e868-4e41-88f5-0bf803a6da2b&q;,&q;language&q;:null,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;ee9794eb-17d0-42dd-8c94-12f3f437c9f0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The Status of Youth in Agrifood Systems&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;f9b54324-01c3-434c-bb7e-24418473de77&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (stand-alone)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;0bb0bcfe-faec-47a5-b16b-91b3d25292a4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Yes&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.cardvisibilitytype&q;:[{&q;uuid&q;:&q;267333a6-07fa-4930-875a-7a5682e6aa20&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Public&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.citation&q;:[{&q;uuid&q;:&q;00496aaf-850d-4b81-a99b-0abdf59