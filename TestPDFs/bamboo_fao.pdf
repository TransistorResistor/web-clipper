;isDiscoverable&q;:true,&q;isWithdrawn&q;:false,&q;_links&q;:{&q;bundles&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/58d34563-09a0-47b1-bf13-8ecc4891d654/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/58d34563-09a0-47b1-bf13-8ecc4891d654/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/58d34563-09a0-47b1-bf13-8ecc4891d654/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/58d34563-09a0-47b1-bf13-8ecc4891d654/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/58d34563-09a0-47b1-bf13-8ecc4891d654/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/58d34563-09a0-47b1-bf13-8ecc4891d654/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/58d34563-09a0-47b1-bf13-8ecc4891d654/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/58d34563-09a0-47b1-bf13-8ecc4891d654/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/58d34563-09a0-47b1-bf13-8ecc4891d654&q;}},&q;_name&q;:&q;Picturing progress – Four betters in focus&q;,&q;id&q;:&q;58d34563-09a0-47b1-bf13-8ecc4891d654&q;,&q;uuid&q;:&q;58d34563-09a0-47b1-bf13-8ecc4891d654&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;eec4acc4-e92f-4cdd-82a1-3571e1e573d9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;b69aaaca-e35e-449a-a9c9-253a8969ed9c&q;,&q;language&q;:null,&q;value&q;:&q;2025-10-15T13:12:43Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;55499591-0522-4971-a9fb-3cf06781e2a3&q;,&q;language&q;:null,&q;value&q;:&q;2025-10-15T13:12:43Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;9dc7930a-7d71-4fe7-a237-94382aea879e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;d6500437-49a1-4f33-8a8e-b1f35460cf3b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-10-15T12:25:02Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;2f8b1284-f010-420a-9c1d-66648cdee864&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This commemorative volume marks the 80th anniversary of the Food and Agriculture Organization of the United Nations (FAO), tracing its journey from a founding conviction – that hunger is not inevitable – to today’s global mission of transforming agrifood systems. Through a rich collection of photographs and narratives, the book illustrates how FAO works alongside farmers, fishers, scientists, governments, Indigenous Peoples, youth and civil society to advance sustainable solutions that nourish both people and planet.Organized around FAO’s vision of the four betters – better production, better nutrition, a better environment and a better life – the book highlights concrete progress: from regenerative farming and climate-smart livestock, to school feeding programmes, land restoration and inclusive digital innovation. It reflects on both the challenges and the opportunities facing agrifood systems, including climate volatility, conflict and inequality, while showing how collaboration, knowledge and innovation create pathways for resilience and hope.Arriving at a moment of reflection and renewal, this volume is both tribute and testimony: to the millions of people whose daily efforts sustain our world, and to FAO’s enduring commitment to building sustainable, inclusive and equitable agrifood systems that leave no one behind.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;e32280fb-9efa-4480-ae0f-96eb62704110&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;164 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;6666ab4c-3cf8-41d2-ad4e-6c7ba59a0e52&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140099-9&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;6c888cb2-010c-4684-bfc1-d76d1ac6dcf8&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd6837en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;4e5a8649-7ae0-45df-a760-5b2f9e418366&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;beeba7b8-fdbc-4dc5-8650-6f2c42ba8f9b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;6f32a59b-6681-41b8-b8d3-2ad94fc8adb6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;3897a1ff-b002-451f-bc1b-734e046a8281&q;,&q;language&q;:null,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;613dc1ad-ff90-4dcd-8f8a-8f26e60a4c3b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Picturing progress – Four betters in focus&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;d8f1c600-cbe7-4053-be3d-1328cbe03526&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (stand-alone)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;4f9ef8c2-88be-4750-92a4-d123f7ee1f6a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Yes&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.cardvisibilitytype&q;:[{&q;uuid&q;:&q;a79251b8-ca2e-493