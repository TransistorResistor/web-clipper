ail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9a576e6b-faa7-414a-919f-8265bc6196c3/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9a576e6b-faa7-414a-919f-8265bc6196c3&q;}},&q;_name&q;:&q;El estado de la seguridad alimentaria y la nutrición en el mundo 2025&q;,&q;id&q;:&q;9a576e6b-faa7-414a-919f-8265bc6196c3&q;,&q;uuid&q;:&q;9a576e6b-faa7-414a-919f-8265bc6196c3&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;d3a8d1da-dac1-48b2-84b7-d4bcc3ac58f5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; FIDA; OMS; PMA; UNICEF;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;28e998d7-2b19-40e9-87f2-1473e233219c&q;,&q;language&q;:null,&q;value&q;:&q;2025-11-25T12:02:23Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;43359963-a63d-4b10-bffc-435a05d7c279&q;,&q;language&q;:null,&q;value&q;:&q;2025-11-25T12:02:23Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;3553aed9-4315-4244-a0c2-ce0c4b1d2eba&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;8720ca3b-f4ab-49d0-8df3-85c266feced0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-11-25T11:57:04Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;ebee8134-f36c-4bdb-b925-971923e70c76&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Aunque en los últimos años se han registrado avances y cierto grado de recuperación, el mundo sigue por encima de los niveles anteriores a la pandemia de la enfermedad por coronavirus (COVID-19) y alejado de la erradicación del hambre y la inseguridad alimentaria para 2030 (meta 2.1 de los Objetivos de Desarrollo Sostenible [ODS]). Análogamente, pese a ciertos avances en el cumplimiento de las metas mundiales en materia de nutrición, el mundo no va camino de cumplir la meta 2.2 de los ODS. Este impulso se ha visto frenado por una inflación persistente de los precios de los alimentos, entre otros factores.En El estado de la seguridad alimentaria y la nutrición en el mundo 2025 se muestra cómo una inflación elevada ha mermado en muchos países el poder adquisitivo y, sobre todo entre las poblaciones de ingresos bajos, el acceso a dietas saludables. En el informe se documenta la vinculación entre la inflación alta de los precios de los alimentos y los aumentos de la inseguridad alimentaria y la malnutrición infantil. Los grupos vulnerables, incluidos los hogares de ingresos bajos, las mujeres y las comunidades rurales, pueden verse especialmente afectados por la inflación de los precios de los alimentos, lo cual comporta el riesgo de reveses en la lucha contra el hambre y la malnutrición.En respuesta a estas dificultades, y para prevenir futuras conmociones de los precios, en el informe se examinan medidas de políticas adoptadas por los países y se describe lo que se necesita para avanzar. Se destaca la importancia de una aplicación coherente de las políticas fiscales y monetarias para estabilizar los mercados, promover un comercio abierto y resiliente y proteger a las poblaciones vulnerables. Además, se propugnan mejoras en los sistemas de datos y una inversión sostenida en sistemas agroalimentarios resilientes para fomentar la seguridad alimentaria y la nutrición a largo plazo. Estas medidas coordinadas son esenciales para reactivar los avances hacia la meta de poner fin al hambre y la malnutrición para 2030.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;d875bba7-825e-43e2-9e10-b6beac1f3f61&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;252 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eisbn&q;:[{&q;uuid&q;:&q;94f57b62-e4ae-4ac6-822a-c94653766628&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140213-9&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;48dd765e-37a5-43fc-924c-5384144aa947&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-855X&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;83d31c81-2a88-4479-831f-e7ea58d1620c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140128-6&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;efd61efa-ba9f-4e13-aa11-5234d61bff5c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8541&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;86a0e5e7-eccf-4b7a-85cc-51aed0f67173&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd6008es&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;a25aec5a-4b59-4138-bbd2-e5d93275e005&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Spanish&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;73eb8710-cfeb-4747-816d-1fd3a90bc306&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; FIDA ; OMS ; PMA ; UNICEF ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;47cd501d-d930-4347-8263-848ddc515695&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;El estado de la seguridad alimentaria y la nutrición en el mundo&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;a2e8398a-cb64-4296-bf04-031a0c217c16&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;6a8727e2-c2c5-4186-b7a6-3cd7e132237d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;e6821ad6-7ec7-4423-a9d5-613780