46bc9f030454&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-10-14T09:13:03Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;0593c5a7-d2c2-4a8b-9de3-77dfa7f1c4f8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;From the State of the World collection and other major reports to freshly penned technical studies, FAO publications cater to a diverse range of audiences. This catalogue presents a selection of FAO’s main publications, produced in 2025 or earlier, ranging from its global reports and general interest publications to numerous specialized titles. In addition to the major themes of agriculture, forestry and fisheries, it also includes thematic sections on climate, economic and social development, and food safety and nutrition.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;0a577af8-6a1d-4970-b543-fd3d5d147d3c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;104 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;d763dbc2-60e7-43fc-bd7e-5dc2c95802de&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140161-3&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;6dcb72e2-f58d-40b7-a939-e9d9fd3e8f92&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd7085en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;ed2b40e9-dc42-4741-87ad-1c0c818438fe&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;0de6403b-32d4-47a5-a463-e93490baae74&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;37fb2181-a7cf-4500-8a37-870b989a72c7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confiden