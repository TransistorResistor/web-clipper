lClassE67CE7116A4A48A2A05A0ADF22E632E9\&q;&g;&l;p&g;FAO, IFAD, UNICEF, WFP and WHO. 2025.&a;#160;&l;em&g;The State of Food Security and Nutrition in the World 2025 –&a;#160;Addressing high food price inflation for food security and nutrition&l;/em&g;.&a;#160;Rome.&l;br&g;&l;/p&g;&l;/div&g;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.contentcategory&q;:[{&q;uuid&q;:&q;b56c85a7-14b5-45a9-a693-e99224716273&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Flagship&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.date.available&q;:[{&q;uuid&q;:&q;6ee5c8e1-6b20-45fa-a581-20d5566a5fef&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-07-27T22:00:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.embargo&q;:[{&q;uuid&q;:&q;068c17b3-3d7d-4383-912e-0774474ff2cf&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Yes&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.embargodate&q;:[{&q;uuid&q;:&q;76aed89a-837c-47bb-a76b-f09da8c0cbd0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-07-28T14:30:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.fasttrack&q;:[{&q;uuid&q;:&q;7a5bb06c-b7f9-473e-8525-6ea202905b89&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.doi&q;:[{&q;uuid&q;:&q;1e58574f-28ea-4672-baeb-0d54849079d7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;https://doi.org/10.4060/cd6008en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.googlebookurl&q;:[{&q;uuid&q;:&q;36931ebf-14e4-46b4-826a-73ad4060c62e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;https://books.google.it/books/about?id=sQ95EQAAQBAJ&a;redir_esc=y&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.jobnumber&q;:[{&q;uuid&q;:&q;cd6c5c25-bb26-484b-a3a4-d1e88e8f9acc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CD6008EN&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.pws&q;:[{&q;uuid&q;:&q;63054f58-8e57-4772-9841-5c901cfe965e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;328712&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.initiator&q;:[{&q;uuid&q;:&q;35b31fbf-6d9e-4532-a1aa-d9192046e035&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Verona, Daniela (ESA)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.leadauthoringunit&q;:[{&q;uuid&q;:&q;e4c18e46-87bb-4673-a883-38b045bb13ee&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;ESA - Agrifood Economics and Policy&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.occnotes&q;:[{&q;uuid&q;:&q;3c8c5132-5410-4506-a183-38d64e0b5eca&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;div class=\&q;ExternalClass8EFFBF524B5C407F9782BEBBE5822166\&q;&g;&l;p&g;&l;strong&g;From&a;#58;&l;/strong&g; Copyright &a;lt;Copyright@fao.org&a;gt; &l;br&g;&l;strong&g;Sent&a;#58;&l;/strong&g; Sunday, July 27, 2025 10&a;#58;45 PM&l;br&g; &l;strong&g;To&a;#58;&l;/strong&g; Galeotti, Laura (OCCP) &a;lt;Laura.Galeotti@fao.org&a;gt;&l;br&g;&l;strong&g;Subject&a;#58;&l;/strong&g; Re&a;#58; SOFI 2025 -In Brief DTP8&l;br&g;&l;/p&g;&l;p&g;Dear Laura,&l;br&g;&l;/p&g;&l;p&g;I had sent a separate message yesterday confirming that FAO has no objection to the highlighted proposed text by the partners below&a;#58;&a;#160; (Resending it also from the copyright now and looping in everyone involved for their information)&l;br&g;&l;/p&g;&l;p&g;&l;em style=\&q;background-color&a;#58;#ffff00;\&q;&g;The terminology used to refer to countries, territories and areas as well as the representation of countries, territories and areas, including the delimitation of frontiers or boundaries, in this publication follow the institutional style and practice of FAO as the lead publishing organization, and may be at variance with those used by IFAD, UNICEF, WFP and WHO.&l;/em&g;&l;/p&g;&l;p&g;English version of the In Brief already has this para included, so consider this cleared by the copyright.&a;#160; Kindly make sure that the highlighted section above is also included in the main report, digital report and all other language version of the In Briefs before they are published tomorrow.&l;br&g;&l;/p&g;&l;p&g;If you need anything else from me, please let me know.&l;br&g;&l;/p&g;&l;p&g;Kind regards,&l;/p&g;&l;p&g;Radhika&l;br&g;&l;/p&g;&l;p&g;&l;span style=\&q;color&a;#58;#000000;font-family&a;#58;&a;quot;helvetica neue&a;quot;;\&q;&g;Copyright&a;#58; FAO&l;/span&g;&l;span class=\&q;Apple-converted-space\&q; style=\&q;color&a;#58;#000000;font-family&a;#58;&a;quot;helvetica neue&a;quot;;\&q;&g;&a;#160;&l;/span&g;&l;/p&g;&l;div&g;&l;p class=\&q;p2\&q; style=\&q;line-height&a;#58;normal;font-size-adjust&a;#58;none;font-feature-settings&a;#58;normal;font-stretch&a;#58;normal;font-family&a;#58;&a;quot;helvetica neue&a;quot;;color&a;#58;#000000;\&q;&g;Logo&a;#58; IFAD, UNICEF, WFP and WHO logos cleared&l;/p&g;&l;p class=\&q;p2\&q; style=\&q;line-height&a;#58;normal;font-size-adjust&a;#58;none;font-feature-settings&a;#58;normal;font-stretch&a;#58;normal;font-family&a;#58;&a;quot;helvetica neue&a;quot;;color&a;#58;#000000;\&q;&g;AU&a;#58; FAO,&a;#160;IFAD, UNICEF, WFP and WHO&l;/p&g;&l;p class=\&q;p2\&q; style=\&q;line-height&a;#58;normal;font-size-adjust&a;#58;none;font-feature-settings&a;#58;normal;font-stretch&a;#58;normal;font-family&a;#58;&a;quot;helvetica neue&a;quot;;color&a;#58;#000000;\&q;&g;PU&a;#58; FAO, IFAD, UNICEF, WFP and WHO&l;/p&g;&l;p class=\&q;p2\&q; style=\&q;line-height&a;#58;normal;font-size-adjust&a;#58;none;font-feature-settings&a;#58;normal;font-stretch&a;#58;normal;font-family&a;#58;&a;quot;helvetica neue&a;quot;;color&a;#58;#000000;\&q;&g;FAO can sell&a;#58; yes&l;br&g;&l;/p&g;&l;p class=\&q;p2\&q; style=\&q;line-height&a;#58;normal;font-size-adjust&a;#58;none;font-feature-settings&a;#58;normal;font-stretch&a;#58;normal;font-family&a;#58;&a;quot;helvetica neue&a;quot;;color&a;#58;#000000;\&q;&g;FAO doi&a;#58; yes&l;br&g;&l;/p&g;&l;p class=\&q;p2\&q; style=\&q;line-height&a;#58;normal;font-size-ad