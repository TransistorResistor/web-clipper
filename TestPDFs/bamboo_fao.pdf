nce&q;:-1}],&q;fao.embargodate&q;:[{&q;uuid&q;:&q;55635b37-a740-4bca-950f-6656ab089f97&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-11-13T09:00:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.fasttrack&q;:[{&q;uuid&q;:&q;7ae5fb76-87f3-4e68-af7d-09a95cf0be7b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.doi&q;:[{&q;uuid&q;:&q;25c57ae2-2fc3-4fc4-b517-a00da755bf8e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;https://doi.org/10.4060/cd7448en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.jobnumber&q;:[{&q;uuid&q;:&q;c9576b38-4814-4531-bb93-ae445e15aa7e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CD7448EN&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.pws&q;:[{&q;uuid&q;:&q;cc3c57b4-62ce-445d-9608-6ef539a1daa6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;330002&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.initiator&q;:[{&q;uuid&q;:&q;7f92d9ae-157f-427f-9a45-a96928b0fa2d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Vecchione, Ettore (EST)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.leadauthoringunit&q;:[{&q;uuid&q;:&q;3ea826f0-a6d3-4426-8d35-f4647841e6b2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;EST - Markets and Trade&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.placeofpublication&q;:[{&q;uuid&q;:&q;30fa511e-eddd-48ec-ba9c-12131a0c86fe&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Rome, Italy ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.previewpage&q;:[{&q;uuid&q;:&q;f865f743-df33-4439-aba4-426938c27535&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;p&g;&l;b&g;Markets at a Glance&l;/b&g;&l;/p&g;&l;ul&g;&l;li&g;&l;b&g;&l;i&g;Cereals&l;/i&g;&l;/b&g;&l;/li&g; This report provides an analysis of the most recent developments in the global cereals market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/cd7448en/cd7448en_cereals.pdf\&q; target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Wheat&l;/i&g;&l;/b&g;&l;/li&g; This report provides an analysis of the most recent developments in the global wheat market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/cd7448en/cd7448en_wheat.pdf\&q; target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Coarse Grains&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global coarse grains market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/cd7448en/cd7448en_grains.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Rice&l;/i&g;&l;/b&g;&l;/li&g; This report provides an analysis of the most recent developments in the global rice market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/cd7448en/cd7448en_rice.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Oilcrops, oils and meals&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global oilcrops market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/cd7448en/cd7448en_oilcrops.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Sugar&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global sugar market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/cd7448en/cd7448en_sugar.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Meat and meat products&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global meat market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/cd7448en/cd7448en_meat.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Milk and milk products&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global milk market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/cd7448en/cd7448en_milk.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;/a&g;&l;/b&g;&l;li&g;&l;b&g;&l;i&g;Fish and other acquatic products&a;nbsp;&l;/i&g;&l;/b&g;&l;/li&g;This report provides an analysis of the most recent developments in the global fish market, including a short-term outlook.&l;b&g;&l;a href=\&q;https://www.fao.org/3/cd7448en/cd7448en_fish.pdf\&q; target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g; Read it here&l;br&g;&l;/a&g;&l;/b&g;&l;/ul&g;&l;p&g;&l;/p&g;&l;p&g;&l;b&g;Special feature&l;/b&g;&l;/p&g;&l;p&g;&l;i&g;Fertilizer market developments&l;/i&g;&l;/p&g;&l;p&g;Fertilizer production rebounded in 2024 and 2025, led by nitrogen and potassium, while prices rose on high energy costs but remain below 2022 peaks. Global trade has stabilized, and short-term supply looks adequate, though policy risks and affordability will shape future trends.&l;b&g;&l;a href=\&q;https://www.fao.org/3/cd7448en/cd7448en_special_feature1.pdf\&q;target=\&q;_blank\&q; class=\&q;external-link-new-window\&q; title=\&q;Opens external link in new window\&q; external=\&q;1\&q;&g;Read it here&l;/a&g;&l;/b&g;&l;/p&g;&l;p&g;&l;i&g;&l;br&g;Focus on olive oil&l;/i&g;&l;/p&g;&l;p&g;International olive oil prices declined significantly from their early 2024 peak following strong supply recovery in the 2024/25 season. As for 2025/26, tentative forecasts point to year-on-year stable olive oil production, while global consumption and trade are expected to keep expanding. Nevertheless, the sector still faces numerous challenges.&a;nbsp;&l;a href=\&q;https://www.fao.org/3/cd7448en/cd7448en_special_feature2.pdf\&q;&g;Read it here&l;/a&g;&l;/p&g;&l;p&g;&l;i&g;&l;br&g;&l;/i&g;&l;/p&g;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.specialapprover.identifier&q;:[{&q;uuid&q;:&q;06a50ac3-a025-46ed-9b3b-9246c2e6a019&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;17&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.subject.agrovoc&q;:[{&q;uuid&q;:&q;f0670b3c-29e7-4ea9-a74d-d2e5b106762d&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;commodity markets&q;,&q;place&q;:0,&q;authority&q;:&q;8718bc88da6d00da6e92a1e8a45adf3b27ceb552&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;6342b5a5-4823-4a0d-8684-8147f4b82efc&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;crop production&q;,&q;place&q;:1,&q;authority&q;:&q;f6b6cf227ca7413f28d8c5ec5c9e07d805acabc9&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;b271f90a-9c66-429b-b6ca-d5c10f987946&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;crop forecasting&q;,&q;place&q;:2,&q;authority&q;:&q;7089b9496923574a7330690fbc4431abd9e887b7&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;18fcf912-e53d-40f4-87e4-cc37ca336ba1&q;,&q;language&q;:&q;en&q;,&q;value&q;:&q;trade policies&q;,&q;place&q;:3,&q;authority&q;:&q;5d26b70276bf0777b63e1ddd20cbcfcb0c6b6495&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;5178eac9-c7a4-4f19-9d67-5ff2ae22a4ea&q;,&q;language&q;:&q;en&q;,&q;value&q;: