confidence&q;:-1}],&q;fao.embargo&q;:[{&q;uuid&q;:&q;9a62bc69-58e3-49a9-8f55-82d12ebd2c44&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.fasttrack&q;:[{&q;uuid&q;:&q;24197128-71de-48bb-80bf-50f5b7fecf07&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.doi&q;:[{&q;uuid&q;:&q;cd77cd1e-ee76-47a6-b3a0-852d7a06df8c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;https://doi.org/10.4060/cd6008ru&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.jobnumber&q;:[{&q;uuid&q;:&q;87d17244-e4b2-4ea6-96ff-ac157a07045b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CD6008RU&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.pws&q;:[{&q;uuid&q;:&q;8f06b05e-935b-4fd5-9607-acacbeb3b8dc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;331656&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.initiator&q;:[{&q;uuid&q;:&q;61e0d722-0f84-4650-9c0f-7ad9a4d9bd07&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Verona, Daniela (ESA)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.leadauthoringunit&q;:[{&q;uuid&q;:&q;c338558a-4cf6-4f1e-9fbf-4f800aeff276&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;ESA - Agrifood Economics and Policy&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.occnotes&q;:[{&q;uuid&q;:&q;8871879f-b362-4cbd-9ff8-6090c9fd352a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;div class=\&q;ExternalClass66DE1A359334428AB9EC75E00C49F281\&q;&g;&l;p&g;&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;As per English record&a;#58;&a;#160;&l;br&g;&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;Dear Laura,&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;&a;#160;&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;I had sent a separate message yesterday confirming that FAO has no objection to the highlighted proposed text by the partners below&a;#58;&a;#160; (Resending it also from the copyright now and looping in everyone involved for their information)&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;&a;#160;&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;&l;em style=\&q;background-color&a;#58;#ffff00;\&q;&g;The terminology used to refer to countries, territories and areas as well as the representation of countries, territories and areas, including the delimitation of frontiers or boundaries, in this publication follow the institutional style and practice of FAO as the lead publishing organization, and may be at variance with those used by IFAD, UNICEF, WFP and WHO.&l;/em&g;&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;&a;#160;&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;English version of the In Brief already has this para included, so consider this cleared by the copyright.&a;#160; Kindly make sure that the highlighted section above is also included in the main report, digital report and all other language version of the In Briefs before they are published tomorrow.&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;&a;#160;&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;If you need anything else from me, please let me know.&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;&a;#160;&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;Kind regards,&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;Radhika&l;br&g;&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;&l;br&g;&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;&l;br&g;&l;/p&g;&l;p style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;1.6;\&q;&g;&l;span style=\&q;color&a;#58;#000000;font-family&a;#58;&a;quot;helvetica neue&a;quot;;\&q;&g;Copyright&a;#58; FAO&l;/span&g;&l;span class=\&q;Apple-converted-space\&q; style=\&q;color&a;#58;#000000;font-family&a;#58;&a;quot;helvetica neue&a;quot;;\&q;&g;&a;#160;&l;/span&g;&l;/p&g;&l;div&g;&l;p class=\&q;p2\&q; style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;normal;font-size-adjust&a;#58;none;font-feature-settings&a;#58;normal;font-stretch&a;#58;normal;font-family&a;#58;&a;quot;helvetica neue&a;quot;;color&a;#58;#000000;\&q;&g;Logo&a;#58; IFAD, UNICEF, WFP and WHO logos cleared&l;/p&g;&l;p class=\&q;p2\&q; style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;normal;font-size-adjust&a;#58;none;font-feature-settings&a;#58;normal;font-stretch&a;#58;normal;font-family&a;#58;&a;quot;helvetica neue&a;quot;;color&a;#58;#000000;\&q;&g;AU&a;#58; FAO,&a;#160;IFAD, UNICEF, WFP and WHO&l;/p&g;&l;p class=\&q;p2\&q; style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;normal;font-size-adjust&a;#58;none;font-feature-settings&a;#58;normal;font-stretch&a;#58;normal;font-family&a;#58;&a;quot;helvetica neue&a;quot;;color&a;#58;#000000;\&q;&g;PU&a;#58; FAO, IFAD, UNICEF, WFP and WHO&l;/p&g;&l;p class=\&q;p2\&q; style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;normal;font-size-adjust&a;#58;none;font-feature-settings&a;#58;normal;font-stretch&a;#58;normal;font-family&a;#58;&a;quot;helvetica neue&a;quot;;color&a;#58;#000000;\&q;&g;FAO can sell&a;#58; yes&l;br&g;&l;/p&g;&l;p class=\&q;p2\&q; style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;normal;font-size-adjust&a;#58;none;font-feature-settings&a;#58;normal;font-stretch&a;#58;normal;font-family&a;#58;&a;quot;helvetica neue&a;quot;;color&a;#58;#000000;\&q;&g;FAO doi&a;#58; yes&l;br&g;&l;/p&g;&l;p class=\&q;p3\&q; style=\&q;margin-bottom&a;#58;10px;line-height&a;#58;normal;font-size-adjust&a;#58;none;font-feature-settings&a;#58;normal;font-stretch&a;#58;normal;font-family&a;#58;&a;quot;helvetica neue&a;quot;;min-height&a;#58;15px;color&a;#58;#000000;\&q;&g;&l;br&g;&l;/p&