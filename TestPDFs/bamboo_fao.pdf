e&q;:&q;20.500.14283/cd4838en&q;,&q;lastModified&q;:&q;2026-02-11T01:10:19.788Z&q;,&q;isArchived&q;:true,&q;isDiscoverable&q;:true,&q;isWithdrawn&q;:false,&q;_links&q;:{&q;bundles&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/edcd537b-2e0e-4f0b-9b04-74518c1224ec/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/edcd537b-2e0e-4f0b-9b04-74518c1224ec/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/edcd537b-2e0e-4f0b-9b04-74518c1224ec/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/edcd537b-2e0e-4f0b-9b04-74518c1224ec/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/edcd537b-2e0e-4f0b-9b04-74518c1224ec/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/edcd537b-2e0e-4f0b-9b04-74518c1224ec/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/edcd537b-2e0e-4f0b-9b04-74518c1224ec/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/edcd537b-2e0e-4f0b-9b04-74518c1224ec/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/edcd537b-2e0e-4f0b-9b04-74518c1224ec&q;}},&q;_name&q;:&q;The Second Report on the State of the World&s;s Forest Genetic Resources&q;,&q;id&q;:&q;edcd537b-2e0e-4f0b-9b04-74518c1224ec&q;,&q;uuid&q;:&q;edcd537b-2e0e-4f0b-9b04-74518c1224ec&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;38a40b56-e430-4d7f-b74b-e48c42061d64&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;e05e91bc-9719-4bf9-8d61-359ef1d9249a&q;,&q;language&q;:null,&q;value&q;:&q;2025-09-05T15:48:49Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;e93bfd0f-4b31-42fe-a2e9-d9d66a1ccde1&q;,&q;language&q;:null,&q;value&q;:&q;2025-09-05T15:48:49Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;7d644657-0cfc-4050-90b0-57490fb5c94e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;9685e792-79ad-43c2-aae2-be33c5ed3d04&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-09-05T15:42:31Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;310d693b-5a7a-45f2-a096-d81a43509bc5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Forests and woodlands provide a huge array of essential benefits for people and the planet – such as hosting biodiversity, supporting livelihoods, protecting soils, regulating water cycles and mitigating climate change. At the heart of such benefits are forest genetic resources: the heritable materials maintained within and among tree and other woody plant species that are of actual or potential economic, environmental, scientific or societal value. These genetic resources underpin the resilience, adaptability and productivity of forests and other tree-based systems, enabling them to withstand environmental stresses and thereby continue providing vital ecosystem services.Drawing on data and information from 77 countries representing more than three-quarters of the world’s forests, The Second Report on the State of the World’s Forest Genetic Resources provides a global assessment of forest genetic resources. It highlights the crucial role of these resources for sustainable development and examines progress in implementing the Global Plan of Action for the Conservation, Sustainable Use and Development of Forest Genetic Resources. The report reviews scientific advances and concludes with recommendations for continued action at the national, regional and global levels to ensure that forest genetic resources are sustainably managed for the benefit of current and future generations.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;a2ce037b-6417-4a9c-9508-bb1a52c74867&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;260 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;d8d2bb67-fdfa-462d-ace4-b369696cb8a6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2412-5482&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;a4b92aee-ea0f-4c7d-9a02-7124e9fd711c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-139699-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;1b637342-3f3c-461b-ada7-e0dd529f5a96&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2412-5474&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;eb0d8f5b-32ec-4b35-95b3-847c95f54b28&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd4838en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;886ece93-ff82-489b-8747-62eda331af06&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;f5952897-a17c-4008-8813-586d49c06b82&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;7073febc-b52a-40d9-a64f-f8e3fd362983&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO Commission on Genetic Resources for Food and Agriculture Assessments&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;c1bc09c9-0267-4153-939e-7020b84789f1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-