knowledge.fao.org/server/api/core/items/74d08f97-306a-4653-8ffe-140a2fc4d783/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/74d08f97-306a-4653-8ffe-140a2fc4d783/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/74d08f97-306a-4653-8ffe-140a2fc4d783/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/74d08f97-306a-4653-8ffe-140a2fc4d783/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/74d08f97-306a-4653-8ffe-140a2fc4d783/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/74d08f97-306a-4653-8ffe-140a2fc4d783/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/74d08f97-306a-4653-8ffe-140a2fc4d783/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/74d08f97-306a-4653-8ffe-140a2fc4d783/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/74d08f97-306a-4653-8ffe-140a2fc4d783&q;}},&q;_name&q;:&q;The Impact of Disasters on Agriculture and Food Security 2025&q;,&q;id&q;:&q;74d08f97-306a-4653-8ffe-140a2fc4d783&q;,&q;uuid&q;:&q;74d08f97-306a-4653-8ffe-140a2fc4d783&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;6893101d-3c48-4419-ae7d-de4c92be8e44&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;33da2a47-60ea-4a91-8c14-45208c081958&q;,&q;language&q;:null,&q;value&q;:&q;2025-11-14T10:47:38Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;0fbaf8a7-144d-4d67-a41b-f71ad006fbe9&q;,&q;language&q;:null,&q;value&q;:&q;2025-11-14T10:47:38Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;acf5fd1e-61fe-4f73-ac0a-2be61f260383&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;0fb7bd0c-8ee8-4c6e-86fa-6327a3f88149&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-11-14T10:43:42Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;9dbf8da0-81e6-4089-8052-e5b63cc4b1aa&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This biennial flagship report provides comprehensive evidence on the escalating impact of disasters on global agricultural systems, revealing losses of USD 3.26 trillion over the period 1991–2023. The 2025 edition introduces enhanced methodologies for assessing disaster impacts across crops, livestock, fisheries and aquaculture subsectors, offering Member States robust data for evidence-based policymaking.Aligned with the 2030 Agenda for Sustainable Development and the Sendai Framework for Disaster Risk Reduction, this edition provides actionable recommendations for integrating disaster risk reduction into agricultural policies and investments through digital innovations. From AI-powered early warning systems to mobile-based insurance reaching millions of smallholder farmers, the report demonstrates how technology is revolutionizing agricultural risk management.Yet technology alone isn&s;t the answer. The report emphasizes putting farmers at the centre – designing solutions with them, not for them – while addressing the digital divide that leaves 2.6 billion people offline. Through compelling case studies and actionable frameworks, it provides a roadmap for building resilient agricultural systems capable of feeding the world in an era of mounting climate risks.This publication serves as an essential resource for governments, development partners, and stakeholders working to build resilient agrifood systems in the face of climate change and increasing disaster risks.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;fb0ee7e6-99ee-4088-90c3-1e6d21c24479&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;144 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eisbn&q;:[{&q;uuid&q;:&q;26a70657-e55d-4514-b993-289b5947cad2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140181-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;d67ab7aa-be10-40b6-8524-af4a5fda1b0b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140180-4&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;b9e7c9d1-2a00-4baa-80fb-985028f1cb1c&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd7185en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;a1c62444-791b-4ebf-8749-a99bdbcb9a7b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;5a8cf5e9-0fa8-45eb-8736-013951769c1e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;888dd470-f0fd-4b74-ab2d-ce52f38ba68a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;09f95dfd-cbb5-4065-89b5-1250a69f850e&q;,&q;language&q;:null,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;07f4beea-8e01-4127-8b45-771508245a28&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The Impact of Disasters on Agriculture and Food Security 2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;a540471b-299f-45a6-9c52-db5fb7eb9c60&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Digital solutions for reducing ri