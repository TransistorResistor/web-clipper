&q;:&q;https://openknowledge.fao.org/server/api/core/items/67a1fe95-98f2-4f23-8be7-99491bfd8343/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/67a1fe95-98f2-4f23-8be7-99491bfd8343/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/67a1fe95-98f2-4f23-8be7-99491bfd8343/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/67a1fe95-98f2-4f23-8be7-99491bfd8343/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/67a1fe95-98f2-4f23-8be7-99491bfd8343/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/67a1fe95-98f2-4f23-8be7-99491bfd8343/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/67a1fe95-98f2-4f23-8be7-99491bfd8343/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/67a1fe95-98f2-4f23-8be7-99491bfd8343&q;}},&q;_name&q;:&q;Global Agrifood Implications of the 2026 Conflict in the Middle East&q;,&q;id&q;:&q;67a1fe95-98f2-4f23-8be7-99491bfd8343&q;,&q;uuid&q;:&q;67a1fe95-98f2-4f23-8be7-99491bfd8343&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;dabdcebd-c7bf-44a0-9520-b559ebf9eb0c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Iran (Islamic Republic of)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;688a2cc6-6f0f-4c23-ba9a-36620386da81&q;,&q;language&q;:null,&q;value&q;:&q;2026-03-19T14:50:27Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;36b7947f-79aa-447d-b415-52a2265b2cd7&q;,&q;language&q;:null,&q;value&q;:&q;2026-03-19T14:50:27Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;e0d37946-b6af-4f7d-8d81-f92b935fa994&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;ae34ac00-0eb0-4448-95bf-eeb812b270b5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-03-19T14:46:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;2c61afea-652b-41da-812e-851310c02b8b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The escalation of conflict in the Islamic Republic of Iran and the Middle East has sharply increased risks to global energy, fertilizer, and agrifood systems. The Strait of Hormuz, a critical chokepoint for oil, gas, and fertilizers, has already seen disruptions that are raising energy and agricultural input costs worldwide. Fertilizer shortages and higher energy prices threaten crop yields, while remittance losses and potential shifts to biofuel production could amplify food price volatility, particularly in Africa, Asia, and other import-dependent regions. Immediate measures such as developing alternative trade routes, strengthening market monitoring, providing financial support for farmers, and offering targeted aid for vulnerable countries are needed to stabilize supply chains. Longer-term strategies should focus on domestic agriculture, sustainable fertilizer production, renewable energy, and structural adjustments, while diplomatic efforts to reopen the Strait of Hormuz remain essential to safeguard global energy and food security.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;70788a1f-3ff4-46b6-9e82-25b71f6c240a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;40&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;ace1e746-73b3-4e50-a734-13ea9d09c159&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8875en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;35f48ee2-077d-4ff5-ab98-62d626118e8d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;7dfc2ab9-e8ff-497c-ba29-d4eeac7cf71e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;1877bb6a-8798-4bba-b0d6-7bea5a751870&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;d36dc6f7-da36-4f18-8961-dc055976bc3f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;e4af3473-f1bb-477a-8252-34334152430c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Global Agrifood Implications of the 2026 Conflict in the Middle East&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;6d4a87e1-ab22-4777-ae2d-806a44802c92&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Impacts on energy and fertilizer trade, and food security&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;105c2758-3d18-414d-aa69-10576835c2b5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Document&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;c39bbfea-7385-4a07-958d-9be4c6a4d67f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.date.available&q;:[{&q;uuid&q;:&q;53831482-4105-4def-a3d7-f48dc8066650&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-03-14T23:00:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.fasttrack&q;:[{&q;uuid&q;:&q;5be1202b-4df1-4151-a823-ea7ea7483b00&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Express&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.jobnumber&q;:[{&q;uuid&q;:&q;3b8036e6-f825-424a-a133-fea0da2e1572&q;,&q;langua