d&q;:[{&q;uuid&q;:&q;3ab72ef5-6290-4391-9213-e7d2cb33b8b3&q;,&q;language&q;:null,&q;value&q;:&q;2025-11-03T16:39:20Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;7d1e5b8f-c63b-4fda-9ec3-370df7b06a7b&q;,&q;language&q;:null,&q;value&q;:&q;2025-11-03T16:39:20Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;7a8a0bca-f5a2-4ba2-858c-96f5896427f0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;4f6757a0-f5a2-46b5-bc7e-3a9ae743327b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-11-03T16:28:53Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;f895954f-a8bb-485d-a2b9-a7333c91ba65&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The Statistical Yearbook 2025 offers a synthesis of the major factors at play in the global food and agricultural landscape. Statistics are presented in four thematic chapters, covering the economic importance of agricultural activities, inputs, outputs and factors of production, their implications for food security and nutrition and their impacts on the environment. The Yearbook is meant to constitute a primary tool for policymakers, researchers and analysts, as well as the general public interested in the past, present and future path of food and agriculture.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;4be8a8b2-2a11-4a05-9cd0-5c5be1843023&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;418 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;ff634cdf-8492-4d98-85a8-c92f625b9417&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140174-3&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;2bc3bdf4-e80f-47d7-8fbf-7e9430d8338b&q;,&q;language&q;:&q;&q;,&q;valu