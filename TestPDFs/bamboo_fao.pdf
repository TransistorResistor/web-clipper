rg/server/api/core/items/feba76d0-dc7e-4ad3-b287-39426f3822fd/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/feba76d0-dc7e-4ad3-b287-39426f3822fd/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/feba76d0-dc7e-4ad3-b287-39426f3822fd/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/feba76d0-dc7e-4ad3-b287-39426f3822fd/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/feba76d0-dc7e-4ad3-b287-39426f3822fd/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/feba76d0-dc7e-4ad3-b287-39426f3822fd/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/feba76d0-dc7e-4ad3-b287-39426f3822fd&q;}},&q;_name&q;:&q;The State of the World’s Land and Water Resources for Food and Agriculture 2025&q;,&q;id&q;:&q;feba76d0-dc7e-4ad3-b287-39426f3822fd&q;,&q;uuid&q;:&q;feba76d0-dc7e-4ad3-b287-39426f3822fd&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;bcfe2665-309a-46e5-827b-76989eaf2693&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;e3f8bdd5-e13f-4dfc-8a45-f175aa4933ab&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-20T11:15:59Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;ea42ddb4-9b26-489a-a8e0-922983a641b0&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-20T11:15:59Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;05c973a2-1c5a-45b4-9260-016dae2fdc61&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;1b6a7f29-f489-47dd-8da4-14114c45457e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-02-20T11:09:40Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;48888821-399f-4f6b-a5a0-259af1ebfea5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;In order to meet the demands of a growing global population, agriculture needs to produce about 50 percent more food, feed and fibre by 2050 compared with the volumes it generated in 2012, according to estimates by the Food and Agriculture Organization of the United Nations (FAO). Achieving such objectives will place additional pressure on the world&s;s already overstretched water, land and soil resources. In an increasing number of regions, food security and agrifood systems are at risk from unsustainable natural resource management practices, urban expansion, higher demand for food, water, energy and biomaterials, and persisting social and gender inequalities in access to and governance of resources. FAO estimates that more than 1.6 billion hectares (ha) of land, corresponding to more than 10 percent of the world’s land area, have been degraded by unsustainable land-use and management practices. More than 60 percent of this degradation occurs on agricultural lands (including cropland and pastureland), creating unprecedented pressure on the world’s agrifood systems. Globally, urban areas more than doubled in size in just two decades, growing from 33 million hectares (Mha) in 1992 to 71 Mha in 2015. This expansion consumed 24 Mha of some of the most fertile croplands, 3.3 Mha of forestlands and 4.6 Mha of shrubland.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;059f0204-5129-4f6e-a3af-a07f010358f7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;148 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eisbn&q;:[{&q;uuid&q;:&q;901e4e69-963f-4b44-ab91-a9e449876daf&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140286-3&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;7d92c263-1ab2-4774-86d8-d0204c507acb&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140285-6&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;1bd0f8c3-4ac6-42f1-abc4-8360279481a4&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd7488en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;94be260f-6b3b-45b6-999c-74d1eff9b29d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;4fdd205c-9f6d-4ff9-969c-7a46fe2f47b8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;21195f2e-94b6-47c4-b603-14b8c2bbbc14&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The State of the World’s Land and Water Resources for Food And Agriculture&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;00729ff7-f5f5-4ab9-9a15-4d0231a8908b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;f30f1150-131c-4178-a41a-aecba81debf8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;8301afa6-631d-4b97-b312-4b828c3b94f3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;2210946d-af8b-4478-a6f0-a3abb295e459&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The State of the World’s Land and Water Resources for Food and Agriculture 2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;f6cac80f-efc3-4407-9a1b-24f26eca2e3e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The potential to produce more and better&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;91651358-c5ea-4c77-8bc1-fa72b74a9a8c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (series)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;2868595c-5dd5-44a3-b0c4-a984eb175b00&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Yes&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.bookcontenttype&q;:[{&q;uuid&q;:&q;367cf413-7203-4c47-b02d-3ebfa8c6467d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Other type&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.cardvisibilitytype&q;:[{&q;uuid&q;:&q;1657257e-2a28-4494-bd5a-20bc7725da3d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Public&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.citation&q;:[{&q;uuid&q;:&q;92785006-8279-4bea-a397-dd65e9c844a8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;div class=\&q;ExternalClassDA2117F7F80E4EDDBABF91391BA429F8\&q;&g;&l;div&g;FAO. 2025.&a;#160;&l;em&g;The State of the World’s Land and Water Resources for Food and Agriculture 2025 – The potential to produce&a;#160;&l;/em&g;&l;span style=\&q;color&a;#58;#212529;\&q;&g;&l;em&g;more and be&l;/em&g;&l;/span&g;&l;span style=\&q;color&a;#58;#212529;\&q;&g;&l;em&g;tter.&a;#160;&l;/em&g;Rome.&l;/span&g;&l;/div&g;&l;p&g;&l;br&g;&l;/p&g;&l;/div&g;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.contentcategory&q;:[{&q;uuid&q;:&q;50f6b90f-41cd-4141-9ddb-eaeea6b091bf&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Flagship&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.date.available&q;:[{&q;uuid&q;:&q;dda7b9a6-f79c-4f4a-8f7d-bbcbc74a1fa0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-11-30T23:00:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.embargo&q;:[{&q;uuid&q;:&q;03097ed5-16b4-4649-9a1b-e0032b54c98a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Yes&q;,&q;place&q;:0,&q;authority&q;:null,&q;conf