nsive evaluation of forest resources and their condition, management and uses, covering all the thematic elements of sustainable forest management. This, the latest of these assessments, examines the status of, and trends in, forest resources over the period 1990–2025, drawing on the efforts of hundreds of experts worldwide. The results of FRA 2025 are available in several formats, including this report, an interactive story on key findings and an online database at https://fra-data.fao.org.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;4d57c848-a0a2-4674-b001-5bf93c472f04&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;210 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;94cc0a31-b5ed-48e2-b5fa-04773d0aa99d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140082-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;6b0a7496-a0dc-4ed3-b10b-2088b8d9ed03&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd6709en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;040a5853-cd9f-4213-b736-21336378a03a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;7dd7169e-540c-44df-b373-29562a6dc921&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;50889824-5153-4d8c-8343-2f78d1e31e78&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;115bce79-7526-4acf-b3ff-32ed5e14df31&q;,&q;language&q;:null,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;f7210f6a-4ffc-4940-b35a-d788e0ecf944&q;,&q;language&q;:&q;&q;,&