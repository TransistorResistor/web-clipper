rg/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/d64140cb-47c3-40fe-9bfe-74deb76a1a6e&q;}},&q;_name&q;:&q;Principes généraux d’hygiène alimentaire&q;,&q;id&q;:&q;d64140cb-47c3-40fe-9bfe-74deb76a1a6e&q;,&q;uuid&q;:&q;d64140cb-47c3-40fe-9bfe-74deb76a1a6e&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;f33eea1b-4763-4e60-a279-36382589eea0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; WHO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;566be32e-7401-4faa-95fe-f3c756a84949&q;,&q;language&q;:null,&q;value&q;:&q;2025-04-15T08:47:24Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;4c2e99a5-e9ea-4928-8ac4-e18e44a308d5&q;,&q;language&q;:null,&q;value&q;:&q;2025-04-15T08:47:24Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;6f95b1a9-366e-42ff-bd85-488f50c32f7f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;8d7266d1-4712-4675-9e3f-956c5b67d438&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-04-15T08:45:40Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;375cf523-954f-4506-9484-b2b5d509af27&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Le présent document énonce les principes généraux qui devraient être compris et respectés par les exploitants du secteur alimentaire au long de la chaîne alimentaire, et constitue une base pour les autorités compétentes chargées de superviser la sécurité sanitaire et la salubrité des aliments.Cette édition contient une nouvelle annexe qui introduit des outils permettant de déterminer les points critiques pour la maîtrise dans un système d’analyse des dangers et points critiques pour leur maîtrise (HACCP).Le terme «Codex Alimentarius» vient du latin et signifie «code alimentaire». Les normes du Codex sont des textes ayant trait à l’alimentation au niveau international, c&s;est-à-dire des normes, des codes d&s;usages, des codes d&s;usages en matière d’hygiène, des lignes directrices et d’autres recommandations, établis pour protéger la santé des consommateurs et garantir des pratiques loyales dans le commerce des denrées alimentaires. L&s;ensemble des normes alimentaires et des textes apparentés adoptés par la Commission du Codex Alimentarius est connu sous le nom de Codex Alimentarius.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;69035729-35ba-41a5-b8a0-b037b33b0334&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;60 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;37b91d30-0462-44eb-966c-5ea2a2c15dac&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cc6125fr&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;c63f9ee6-b96e-453a-8d7b-9