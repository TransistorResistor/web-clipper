;,&q;id&q;:&q;eaf71fe4-8559-428d-8809-ac8212989376&q;,&q;uuid&q;:&q;eaf71fe4-8559-428d-8809-ac8212989376&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;95f10374-1c3e-4725-bd8e-55868416953d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;1733028b-2d9c-4120-9549-18543780103b&q;,&q;language&q;:null,&q;value&q;:&q;2025-11-20T18:17:35Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;2a64a7bf-2786-4d36-a617-dc3f4d176887&q;,&q;language&q;:null,&q;value&q;:&q;2025-11-20T18:17:35Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;156fa4d2-d7c8-4860-82b8-00f7e2db812f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;bc69429b-7b8a-4385-b2e9-bbcf822de30f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-11-20T09:43:46Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;974e939c-4051-4323-8576-8ccbd2ca48c5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Agricultural markets remain highly sensitive to a variety of external shocks, including weather fluctuations and policy developments, and merit regular monitoring. According to the latest FAO assessments, global food commodity production has broadly increased, supported by strong consumption growth and a recovery in inventories. However, the trade outlook continues to be clouded by an evolving global trade environment and persistent policy uncertainties. Beyond the core market assessments for major food commodities, each edition includes special feature articles and key market indicators. The November 2025 edition provides an update on the fertilizer market and recent developments in olive oil markets. The overview of market indicators summarizes trends in futures markets, ocean freight rates, the global food import bill, and food price indices.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;1a4c6d22-f651-499d-ae0c-b88dd7ab21db&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;88 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;22ab6d7d-15ee-4a36-baad-75ff131b1cef&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1560-8182&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;6447386d-ce76-4463-86a2-ddba85002194&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140262-7&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;15158c38-8d4b-40b2-98d1-439c0d72b8dc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;0251-1959&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;d0fe4d5e-db7e-4cee-9945-ec9acba9d19d&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd7448en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;7de4e104-ee9c-43ea-938a-105dad68a6d4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;62eec613-e6c3-4c4c-a317-cf9143ead514&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;d2f342f8-31aa-440e-acd1-3a3ac66938b9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Food Outlook&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;4a2a45ed-d126-4015-85e6-c6e194abcdc1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;November 2025&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;c232f1dc-897f-417b-97e6-cdb55f3004e8&q;,&q;language&q;:&q;&q;,&q