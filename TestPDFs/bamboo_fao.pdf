770872480e2&q;,&q;uuid&q;:&q;853fcdb9-9320-4b3b-8ca1-4770872480e2&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;9ae2de61-702a-48f3-8f12-7e0d913dabf6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;cc23d04c-c094-4dd9-90dd-4a75f2f91f1e&q;,&q;language&q;:null,&q;value&q;:&q;2026-03-06T14:42:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;5abb932a-1972-42f7-ad8f-cd5bb4eddbea&q;,&q;language&q;:null,&q;value&q;:&q;2026-03-06T14:42:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;3d003c2b-51d8-4490-90d8-485bd74249d2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2024&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;ec5e9e22-c01c-4073-a352-4fd8db2fdec2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-03-06T14:36:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;876ec75b-1348-4e70-8c84-6f1b70acc6fe&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;تولي طبعة عام 2024 من تقرير حالة الموارد السمكية وتربية الأحياء المائية في العالم، أهمية خاصة لتنفيذ التحوّّل الأزرق على أرض الواقع من خلال أنشطة ومبادرات تقودها المنظمة بالتعاون مع الأعضاء والشركاء وأصحاب المصلحة الرئيسيين وتهدف إلى دمج الأغذية المائية في الأمن الغذائي العالمي والاستدامة، وتحسين الدعوة في مجال السياسات، والبحوث العلمية وبناء القدرات، ونشر الممارسات المستدامة والابتكارات التكنولوجية، ودعم مشاركة المجتمعات المحلية. ويستفيد الجزء الأول من هذا الإصدار من تقرير حالة الموارد السمكية وتربية الأحياء المائية في العالم من التحسينات الكبرى التي تحققت في مجال جمع البيانات، وأدوات التحليل والتقييم، والمنهجيات المتبعة، لعرض أحدث استعراض لإنتاج مصايد الأسماك وتربية الأحياء المائية في العالم واستخدامه. ويسلّّط الجزء الثاني الضوء على دور المنظمة وشركائها في تحفيز التغيّّرات التحوّّلية اللازمة لدعم توسيع نطاق تربية الأحياء المائية وتكثيفها، والإدارة الفعالة لمصايد الأسماك العالمية، وتطوير سلاسل القيمة المائية. ويتناول الجزء الثالثالتحديات والفرص العالية التأثير التي تنطوي عليها الإمكانات غير المستغلة لاستخدام الأسماك كاملة ومشتقاتها من أجل تحسين الأمن الغذائي والتغذية، ويشرح دور نظم الأغذية المائية في توفير حلول حاسمة ومؤاتية للمناخ والتنوع البيولوجي والبيئية، ويسلّّط الضوء على أهمية دمج هذه الحلول في العمليات الوطنية والمتعددة الأطراف. ويعرض الجزء الثالث أيضًًا نظرة استشرافية على الاتجاهات المستقبلية حتى عام 2032 بناءًً على الإسقاطات المتاحة.ويقدّّم تقرير حالة الموارد السمكية وتربية الأحياء المائية في العالم 2024 أحدث المعلومات القائمة على الأدلة، والسياسات الداعمة، والرؤى العلمية والتقنية حول التحديات والفرص والابتكارات التي ترسم ملامح القطاع اليوم وفي المستقبل لخدمة جمهور واسع ومتزايد من واضعي السياسات، والمديرين، والعلماء، والصيادين، ومزارعي الأسماك، والتجار، والناشطين في المجتمع المدني، والمستهلكين.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;833b7f1b-d034-40c4-9c7b-aa8faea6178c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;262 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eisbn&q;:[{&q;uuid&q;:&q;2528bbf8-5489-4e92-a758-cda133d05f6c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-138809-9&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;b4231f1a-445b-43d7-bd3a-b5bc9873f83f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-138810-5&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;f137bc4c-77fd-4f52-b492-a3f5b537259d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8665&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;76508ca7-7373-4121-bf4e-f243022ccd2b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-138808-2&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;fb4db5c6-a341-4421-87b9-9cc2071822